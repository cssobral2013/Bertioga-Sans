    sub iocyr [acutecomb gravecomb acute grave]' by [acute acute acute acute];
    sub yatcyr [acutecomb gravecomb acute grave]' by [acute acute acute acute];
  } liga_2;


  lookup liga_3 {
  # GSUB lookup 16, type 14 (Ligature)
