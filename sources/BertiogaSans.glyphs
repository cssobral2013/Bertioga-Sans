  script hebr; # Hebrew

  lookup ccmp_hebr_1 {
  # GSUB lookup 6, type 14 (Ligature)
    lookupflag RightToLeft;
    sub hatafsegol-hb siluqleft-hb by hatafsegol-hb_siluqleft-hb;
    sub hatafpatah-hb siluqleft-hb by hatafpatah-hb_siluqleft-hb;
    sub hatafqamats-hb siluqleft-hb by hatafqamats-hb_siluqleft-hb;
    sub alef-hb dagesh-hb by alefdagesh;
    sub bet-hb dagesh-hb by betdagesh-hb;
    sub gimel-hb dagesh-hb by gimeldagesh-hb;
    sub dalet-hb dagesh-hb by daletdagesh-hb;
    sub he-hb dagesh-hb by hedagesh-hb;
    sub vav-hb holam-hb by vavholam-hb;
    sub vav-hb dagesh-hb by vavdagesh-hb;
    sub zayin-hb dagesh-hb by zayindagesh-hb;
    sub tet-hb dagesh-hb by tetdagesh-hb;
    sub yod-hb dagesh-hb by yoddagesh-hb;
    sub yod-hb hiriq-hb by yodhiriq-hb;
    sub finalkaf-hb sheva-hb by finalkafsheva;
    sub finalkaf-hb qamats-hb by finalkafqamats;
    sub finalkaf-hb dagesh-hb by finalkafdagesh-hb;
    sub kaf-hb dagesh-hb by kafdagesh-hb;
    sub lamed-hb dagesh-hb holam-hb by lamedholamdagesh;
    sub lamed-hb holam-hb by lamedholam;
    sub lamed-hb dagesh-hb by lameddagesh-hb;
    sub mem-hb dagesh-hb by memdagesh-hb;
    sub nun-hb dagesh-hb by nundagesh-hb;
    sub samekh-hb dagesh-hb by samekhdagesh-hb;
    sub finalpe-hb dagesh-hb by finalpedagesh-hb;
    sub pe-hb dagesh-hb by pedagesh-hb;
    sub tsadi-hb dagesh-hb by tsadidagesh-hb;
    sub qof-hb dagesh-hb by qofdagesh-hb;
    sub resh-hb dagesh-hb by reshdagesh-hb;
    sub shin-hb sindot-hb dagesh-hb by shindageshsindot-hb;
    sub shin-hb dagesh-hb sindot-hb by shindageshsindot-hb;
    sub shin-hb shindot-hb dagesh-hb by shindageshshindot-hb;
    sub shin-hb dagesh-hb shindot-hb by shindageshshindot-hb;
    sub shin-hb dagesh-hb by shindagesh-hb;
    sub shin-hb sindot-hb by shinsindot-hb;
    sub shin-hb shindot-hb by shinshindot-hb;
    sub tav-hb dagesh-hb by tavdagesh-hb;
  } ccmp_hebr_1;


  lookup ccmp_hebr_2 {
  # GSUB lookup 8, type 16 (Chaining Context)
    lookupflag RightToLeft;
    sub [alef-hb bet-hb kaf-hb pe-hb yodyod-hb]' lookup ccmp_hebr_3 @ccmp2;
  } ccmp_hebr_2;";
tag = ccmp;
},
{
code = "# GSUB feature: Localized Forms
# Lookups: 4

  script latn; # Latin
    language MAH ; # Marshallese
    sub [Lcommaaccent lcommaaccent Ncommaaccent ncommaaccent] by [Lcommaaccent.loclMAH lcommaaccent.loclMAH Ncommaaccent.loclMAH ncommaaccent.loclMAH];

    lookup locl_latn_1 {
    sub Scedilla by Scommaaccent;
    sub scedilla by scommaaccent;
    } locl_latn_1;

    lookup locl_latn_2 {
    sub i by i.loclTRK;
    } locl_latn_2;

    language ROM ;
    lookup locl_latn_1;
    language MOL ;
    lookup locl_latn_1;
    language TRK ;
    lookup locl_latn_2;
    language KAZ ;
    lookup locl_latn_2;
    language AZE ;
    lookup locl_latn_2;
    language CRT ;
    lookup locl_latn_2;
    language TAT ;
    lookup locl_latn_2;
    language CAT ;
    sub L' periodcentered' L by Ldot;
    sub l' periodcentered' l by ldot;
    language NLD ;
    sub Iacute J' by Jacute.loclNLD;
    sub iacute j' by jacute.loclNLD;


  script cyrl; # Cyrillic
    language SRB ; # Serbian
    sub becyr by becyr.loclSRB;

    language MKD ; # Macedonian
    sub becyr by becyr.loclSRB;

    language BGR ; # Bulgarian
    sub @locl by @locl2;
   
    language BSH ;
    sub [Estailcyr estailcyr Zetailcyr zetailcyr] by [Estailcyr.loclBSH estailcyr.loclBSH Zetailcyr.loclBSH zetailcyr.loclBSH];
    
    language CHU ;
    sub [Estailcyr estailcyr] by [Estailcyr.loclCHU estailcyr.loclCHU];";
tag = locl;
},
{
code = "# GSUB feature: Contextual Alternates
# Lookups: 1

  sub yukrcyr' yukrcyr by yukrcyr.calt;
  sub yukrcyr.calt yukrcyr' by yukrcyr.calt2;
  sub Yukrcyr' Yukrcyr by Yukrcyr.calt;
  sub Yukrcyr.calt Yukrcyr' by Yukrcyr.calt2;";
tag = calt;
},
